---
interface Props {
  name: string;
  alt: string;
  priority?: boolean;
  class?: string;
  sizes?: string;
  mobile?: string;
  lightbox?: boolean;
}
const {
  name,
  alt,
  priority = false,
  class: className = '',
  sizes = '(max-width: 760px) 100vw, 60vw',
  mobile,
  lightbox = false,
} = Astro.props;
const widths = [480, 800, 1200, 1600];
const set = (slug: string, ext: string) =>
  widths.map((w) => `/media/${slug}-${w}.${ext} ${w}w`).join(', ');
---

<picture class:list={['media', className]}>
  {mobile && (
    <source
      media="(max-width: 640px)"
      type="image/avif"
      srcset={set(mobile, 'avif')}
      sizes="100vw"
    />
  )}
  {mobile && (
    <source
      media="(max-width: 640px)"
      type="image/webp"
      srcset={set(mobile, 'webp')}
      sizes="100vw"
    />
  )}
  <source type="image/avif" srcset={set(name, 'avif')} sizes={sizes} />
  <source type="image/webp" srcset={set(name, 'webp')} sizes={sizes} />
  <img
    src={`/media/${name}-1200.jpg`}
    alt={alt}
    width="1536"
    height="1024"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    data-lightbox={lightbox ? `/media/${name}-1600.webp` : undefined}
  />
</picture>
