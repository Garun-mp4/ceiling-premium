---
import Arrow from './Arrow.astro';
import { site } from '../data/site';
const { source = 'contact' } = Astro.props;
---

<form
  class="lead-form"
  action="/api/lead"
  method="post"
  data-lead-form
  data-source={source}
  novalidate
>
  <label>
    Телефон <span class="required-note">обязательно</span>
    <input
      type="tel"
      name="phone"
      autocomplete="tel"
      inputmode="tel"
      placeholder="+7 999 123-45-67"
      required
      maxlength="32"
      aria-describedby="phone-help"
    />
    <span class="field-error" data-error="phone"></span>
  </label>
  <p class="field-help" id="phone-help">
    Свяжемся, обсудим задачу и удобное время замера.
  </p>
  <label>
    Как к вам обращаться <span class="required-note">необязательно</span>
    <input type="text" name="name" autocomplete="name" maxlength="80" placeholder="Ваше имя" />
    <span class="field-error" data-error="name"></span>
  </label>
  <label>
    Что планируете? <span class="required-note">необязательно</span>
    <textarea
      name="comment"
      rows="3"
      maxlength="1000"
      placeholder="Комната, район, пожелания по свету"
    ></textarea>
    <span class="field-error" data-error="comment"></span>
  </label>
  <div class="honeypot" aria-hidden="true">
    <label>
      Ваш сайт
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <label class="consent-label">
    <input type="checkbox" name="privacyConsent" required />
    <span>
      Даю{' '}
      <a href="/consent/" target="_blank" rel="noopener">
        согласие на обработку персональных данных
      </a>{' '}
      и ознакомлен(а) с{' '}
      <a href="/privacy/" target="_blank" rel="noopener">
        политикой
      </a>
      .
    </span>
  </label>
  <span class="field-error" data-error="privacyConsent"></span>
  <button class="button" type="submit" disabled>
    <span data-submit-label>Обсудить мой проект</span>
    <span class="submit-spinner" aria-hidden="true"></span>
    <span class="submit-arrow" aria-hidden="true">
      <Arrow />
    </span>
  </button>
  <div class="form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1">
    <svg class="status-symbol" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
      <g class="status-check">
        <circle cx="14" cy="14" r="12" />
        <path d="m8 14 4 4 8-8" />
      </g>
      <g class="status-cross">
        <circle cx="14" cy="14" r="12" />
        <path d="m10 10 8 8m0-8-8 8" />
      </g>
      <g class="status-wait">
        <circle cx="14" cy="14" r="12" />
        <path d="M14 7v7l4 3" />
      </g>
    </svg>
    <div data-status-content hidden>
      <strong class="status-title" data-status-title></strong>
      <p class="status-message" data-status-message></p>
      <button class="text-link status-retry" type="button" data-status-retry hidden>
        Попробовать ещё раз
      </button>
    </div>
  </div>
  <noscript>
    <p>
      Для отправки формы включите JavaScript или <a href={site.telegram}>напишите нам в Telegram</a>
      .
    </p>
  </noscript>
</form>
