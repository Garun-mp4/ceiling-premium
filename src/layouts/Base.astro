---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/motion.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { title: string; href: string }[];
}
const {
  title,
  description,
  image = '/brand/og-pole.jpg',
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isPreview = import.meta.env.VERCEL_ENV === 'preview';
const metrika = import.meta.env.PUBLIC_YANDEX_METRIKA_ID || '';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      inLanguage: 'ru-RU',
    },
    ...(breadcrumbs.length
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [{ title: 'Главная', href: '/' }, ...breadcrumbs].map(
              (item, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name: item.title,
                item: new URL(item.href, site.url).href,
              }),
            ),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | ПОЛЕ</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F7F5F0" />
    <meta name="color-scheme" content="light" />
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ПОЛЕ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-dark-32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/manrope-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/onest-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-metrika={metrika}>
    <Header />
    <main id="main" tabindex="-1">
      {breadcrumbs.length > 0 && (
        <nav class="shell breadcrumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a>
          {breadcrumbs.map((item, index) => (
            <>
              <span aria-hidden="true">/</span>
              {index === breadcrumbs.length - 1 ? (
                <span aria-current="page">{item.title}</span>
              ) : (
                <a href={item.href}>{item.title}</a>
              )}
            </>
          ))}
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    <dialog class="lightbox" aria-label="Просмотр фотографии">
      <button class="lightbox-close" aria-label="Закрыть фотографию" type="button">
        ×
      </button>
      <button class="lightbox-prev" aria-label="Предыдущая фотография" type="button">
        ←
      </button>
      <figure>
        <img
          src="/media/hero-desktop-1600.webp"
          alt="Интерьер с натяжным потолком"
          loading="lazy"
        />
        <figcaption></figcaption>
      </figure>
      <button class="lightbox-next" aria-label="Следующая фотография" type="button">
        →
      </button>
    </dialog>
    <section class="cookie-banner" aria-label="Настройки аналитики" hidden>
      <div>
        <strong>Сделаем сайт удобнее</strong>
        <p>
          С вашего согласия используем аналитику посещений. Настройки калькулятора работают
          независимо от неё. <a href="/cookies/">Подробнее</a>
        </p>
      </div>
      <div class="cookie-actions">
        <button class="button button-small" data-cookie-accept>
          Разрешить
        </button>
        <button class="button button-outline button-small" data-cookie-reject>
          Только необходимые
        </button>
      </div>
    </section>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
